<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Аукцион</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: #1c1c1e;
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 16px;
      padding-bottom: 20px;
    }
    
    .header {
      text-align: center;
      margin-bottom: 20px;
    }
    .header-title {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 8px;
      position: relative;
    }
    .header-title::before,
    .header-title::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 40px;
      height: 1px;
      background: #8e8e93;
    }
    .header-title::before { left: 20%; }
    .header-title::after { right: 20%; }
    
    .max-bid-label {
      font-size: 14px;
      color: #8e8e93;
      margin-bottom: 4px;
    }
    .max-bid-value {
      font-size: 32px;
      font-weight: 700;
      color: #0a84ff;
    }
    
    .bidders-container {
      flex: 1;
      background: #2c2c2e;
      border-radius: 14px;
      margin: 16px 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .bidders-list {
      flex: 1;
      overflow-y: auto;
      padding: 12px;
    }
    .bidder-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 14px;
      background: #3a3a3c;
      border-radius: 10px;
      margin-bottom: 8px;
      font-size: 15px;
    }
    .bidder-item:last-child { margin-bottom: 0; }
    .bidder-rank {
      color: #8e8e93;
      margin-right: 10px;
      min-width: 22px;
    }
    .bidder-name {
      flex: 1;
      font-weight: 500;
    }
    .bidder-amount {
      color: #0a84ff;
      font-weight: 600;
    }
    .empty-state, .loading, .error {
      text-align: center;
      color: #8e8e93;
      padding: 40px 20px;
      font-size: 15px;
    }
    
    .controls {
      margin-top: auto;
    }
    .step-info {
      text-align: center;
      font-size: 13px;
      color: #8e8e93;
      margin-bottom: 12px;
    }
    
    .amount-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }
    .btn-circle {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      border: none;
      background: #0a84ff;
      color: white;
      font-size: 24px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .btn-circle:active { opacity: 0.8; }
    
    .amount-display {
      flex: 1;
      height: 48px;
      background: #2c2c2e;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: 600;
    }
    
    .btn-place {
      width: 100%;
      height: 52px;
      border: none;
      border-radius: 14px;
      background: #0a84ff;
      color: white;
      font-size: 17px;
      font-weight: 600;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .btn-place:active { opacity: 0.85; }
    .btn-place:disabled {
      background: #3a3a3c;
      color: #8e8e93;
    }
  </style>
</head>
<body>
  <div class="header">
    <div class="header-title">Сделать ставку</div>
    <div class="max-bid-label">Текущая максимальная ставка</div>
    <div class="max-bid-value" id="maxBid">0 ₽</div>
  </div>

  <div class="bidders-container">
    <div class="bidders-list" id="biddersList">
      <div class="loading">Загрузка...</div>
    </div>
  </div>

  <div class="controls">
    <div class="step-info">Шаг 50 ₽ · Поставь 0 — убрать свою ставку</div>
    
    <div class="amount-row">
      <button class="btn-circle" id="btnMinus">−</button>
      <div class="amount-display" id="amountDisplay">0</div>
      <button class="btn-circle" id="btnPlus">+</button>
    </div>
    
    <button class="btn-place" id="btnPlace">Сделать ставку</button>
  </div>

 <script>
  // ========== CONFIG ==========
  // PASTE THE NEW URL HERE ↓
  const API_URL = 'https://script.google.com/macros/s/AKfycbzo3u4UPpIutwEol6NBL5YXhnGrUOvcltx78_QabaSWPMPYfneqZjc3Ejs7KB_HkOC9yA/exec';
  const STEP = 50;
  // ============================

  const tg = window.Telegram.WebApp;
  tg.ready();
  tg.expand();
  tg.setHeaderColor('#1c1c1e');
  tg.setBackgroundColor('#1c1c1e');

  let currentAmount = 0;
  let user = null;
  let isSubmitting = false;

  if (tg.initDataUnsafe && tg.initDataUnsafe.user) {
    user = tg.initDataUnsafe.user;
  } else {
    user = { id: 123456789, username: 'test_user', first_name: 'Test' };
  }

  const maxBidEl = document.getElementById('maxBid');
  const listEl = document.getElementById('biddersList');
  const amountDisplay = document.getElementById('amountDisplay');
  const btnPlace = document.getElementById('btnPlace');

  document.getElementById('btnPlus').addEventListener('click', () => {
    currentAmount += STEP;
    updateAmountUI();
  });

  document.getElementById('btnMinus').addEventListener('click', () => {
    currentAmount = 0;
    updateAmountUI();
  });

  btnPlace.addEventListener('click', placeBid);

  function updateAmountUI() {
    amountDisplay.textContent = currentAmount;
  }

  async function fetchBids() {
    try {
      const res = await fetch(API_URL);
      const data = await res.json();
      
      if (!data.success) throw new Error(data.error || 'Ошибка');
      
      maxBidEl.textContent = data.maxBid + ' ₽';
      renderList(data.bids);
    } catch (err) {
      console.error(err);
      listEl.innerHTML = `<div class="error">Ошибка загрузки</div>`;
    }
  }

  function renderList(bids) {
    if (!bids || bids.length === 0) {
      listEl.innerHTML = `<div class="empty-state">Пока нет ставок</div>`;
      return;
    }

    listEl.innerHTML = bids.map((b, i) => `
      <div class="bidder-item">
        <span class="bidder-rank">${i + 1}.</span>
        <span class="bidder-name">@${b.username || 'user' + b.telegram_id}</span>
        <span class="bidder-amount">${b.bid_amount} ₽</span>
      </div>
    `).join('');
  }

async function placeBid() {
  if (isSubmitting || !user) return;
  
  isSubmitting = true;
  btnPlace.disabled = true;
  btnPlace.textContent = 'Отправка...';

  try {
    const payload = {
      action: 'placeBid',
      telegram_id: user.id,
      username: user.username || user.first_name || ('user' + user.id),
      amount: currentAmount
    };

    // === NEW WORKING METHOD ===
    const res = await fetch(API_URL, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      body: new URLSearchParams(payload).toString()
    });

    const text = await res.text();
    console.log('Server response:', text);

    const data = JSON.parse(text);
    
    if (data.success) {
      tg.showAlert(data.message || 'Ставка принята!');
      currentAmount = 0;
      updateAmountUI();
      await fetchBids();
    } else {
      tg.showAlert(data.error || 'Ошибка');
    }
  } catch (err) {
    console.error(err);
    tg.showAlert('Ошибка сети: ' + err.message);
  } finally {
    isSubmitting = false;
    btnPlace.disabled = false;
    btnPlace.textContent = 'Сделать ставку';
  }
}

  // Load + poll every 2.5 sec
  fetchBids();
  setInterval(fetchBids, 2500);
</script>

    // Initial load + polling every 2.5 seconds
    fetchBids();
    setInterval(fetchBids, 2500);
  </script>
</body>
</html>
