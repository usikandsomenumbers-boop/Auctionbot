<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Аукцион</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--tg-theme-bg-color, #1c1c1e);
      color: var(--tg-theme-text-color, #ffffff);
      min-height: 100vh;
      padding: 16px;
      padding-bottom: 160px;
    }
    .timer {
      text-align: center;
      font-size: 22px;
      font-weight: 700;
      margin-bottom: 8px;
      color: #ff6b6b;
    }
    .timer.ended { color: #888; }
    .header { text-align: center; margin-bottom: 16px; }
    .max-bid-label { font-size: 13px; opacity: 0.65; margin-bottom: 2px; }
    .max-bid {
      font-size: 32px;
      font-weight: 700;
      color: var(--tg-theme-button-color, #3390ec);
    }
    .bids-list {
      background: var(--tg-theme-secondary-bg-color, #2c2c2e);
      border-radius: 14px;
      overflow: hidden;
      max-height: 45vh;
      overflow-y: auto;
    }
    .bid-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 13px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
      font-size: 15px;
    }
    .bid-item:last-child { border-bottom: none; }
    .bid-item.my-bid { background: rgba(51, 144, 236, 0.18); }
    .bid-name { opacity: 0.9; }
    .bid-amount { font-weight: 600; }
    .empty {
      text-align: center;
      padding: 40px 20px;
      opacity: 0.45;
      font-size: 15px;
    }
    .status {
      text-align: center;
      font-size: 13px;
      margin-top: 10px;
      opacity: 0.6;
      min-height: 18px;
    }
    .bid-panel {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: var(--tg-theme-bg-color, #1c1c1e);
      border-top: 1px solid rgba(255,255,255,0.1);
      padding: 12px 16px 22px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .controls { display: flex; align-items: center; gap: 10px; }
    .btn {
      width: 48px; height: 48px;
      border: none; border-radius: 12px;
      background: var(--tg-theme-button-color, #3390ec);
      color: var(--tg-theme-button-text-color, #fff);
      font-size: 24px; font-weight: 600;
      cursor: pointer; flex-shrink: 0;
    }
    .btn:active { opacity: 0.75; }
    input {
      flex: 1; height: 48px;
      border: none; border-radius: 12px;
      background: var(--tg-theme-secondary-bg-color, #2c2c2e);
      color: var(--tg-theme-text-color, #fff);
      font-size: 20px; font-weight: 600;
      text-align: center; outline: none;
    }
    .place-btn {
      height: 50px; border: none; border-radius: 12px;
      background: var(--tg-theme-button-color, #3390ec);
      color: var(--tg-theme-button-text-color, #fff);
      font-size: 16px; font-weight: 600; cursor: pointer;
    }
    .place-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .hint { font-size: 12px; text-align: center; opacity: 0.55; }
  </style>
</head>
<body>

  <div class="timer" id="timer">—:—:—</div>

  <div class="header">
    <div class="max-bid-label">Текущая максимальная ставка</div>
    <div class="max-bid" id="maxBid">0 ₽</div>
  </div>

  <div class="bids-list" id="bidsList">
    <div class="empty">Загрузка...</div>
  </div>

  <div class="status" id="status"></div>

  <div class="bid-panel">
    <div class="hint">Шаг 50 ₽ · Поставь 0 — убрать свою ставку</div>
    <div class="controls">
      <button class="btn" id="minusBtn">−</button>
      <input type="number" id="bidInput" value="0" min="0" step="50" inputmode="numeric" />
      <button class="btn" id="plusBtn">+</button>
    </div>
    <button class="place-btn" id="placeBtn">Сделать ставку</button>
  </div>

  <script>
    // ========== ВСТАВЬ НОВЫЙ URL ПОСЛЕ ДЕПЛОЯ ==========
    const API_URL = 'https://script.google.com/macros/s/AKfycbzjJIyVJB04DzaUuxtQLxR2TIYFSdiEouSlmvXqHRbad1RSD1EYmWEMEL1tpYS0VBf5/exec';

    const tg = window.Telegram.WebApp;
    tg.ready();
    tg.expand();

    const user = tg.initDataUnsafe?.user || {};
    const userId = user.id || 0;
    const initData = tg.initData || '';

    let step = 50;
    let maxBid = 0;
    let endTime = null;
    let isEnded = false;
    let timerInterval = null;

    function updateTimer() {
      if (!endTime) return;
      const left = new Date(endTime) - Date.now();
      const el = document.getElementById('timer');

      if (left <= 0) {
        el.textContent = 'Аукцион завершён';
        el.classList.add('ended');
        isEnded = true;
        document.getElementById('placeBtn').disabled = true;
        clearInterval(timerInterval);
        return;
      }

      const h = Math.floor(left / 3600000);
      const m = Math.floor((left % 3600000) / 60000);
      const s = Math.floor((left % 60000) / 1000);

      el.textContent =
        String(h).padStart(2, '0') + ':' +
        String(m).padStart(2, '0') + ':' +
        String(s).padStart(2, '0');
    }

    function render(data) {
      if (!data || data.ok === false) {
        if (data && data.error) setStatus(data.error);
        return;
      }

      maxBid = data.max_bid || 0;
      step = data.step || 50;
      endTime = data.end_time;

      document.getElementById('maxBid').textContent =
        maxBid.toLocaleString('ru-RU') + ' ₽';

      const list = document.getElementById('bidsList');
      if (!data.bids || data.bids.length === 0) {
        list.innerHTML = '<div class="empty">Пока нет ставок</div>';
      } else {
        list.innerHTML = data.bids.map(b => `
          <div class="bid-item ${String(b.user_id) === String(userId) ? 'my-bid' : ''}">
            <span class="bid-name">${escapeHtml(b.name)}</span>
            <span class="bid-amount">${Number(b.amount).toLocaleString('ru-RU')} ₽</span>
          </div>
        `).join('');
      }

      const input = document.getElementById('bidInput');
      if (!input.matches(':focus')) {
        input.value = maxBid + step;
      }

      updateTimer();
      if (!timerInterval) timerInterval = setInterval(updateTimer, 1000);
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text || '';
      return div.innerHTML;
    }

    function setStatus(text) {
      document.getElementById('status').textContent = text || '';
    }

    async function loadBids() {
      try {
        const res = await fetch(API_URL + '?t=' + Date.now());
        const data = await res.json();
        render(data);
      } catch (e) {
        setStatus('Ошибка загрузки');
        console.error(e);
      }
    }

    async function placeBid() {
      if (isEnded) {
        tg.showAlert('Аукцион уже закончился');
        return;
      }
      if (!userId) {
        tg.showAlert('Открой через Telegram');
        return;
      }

      const amount = parseInt(document.getElementById('bidInput').value) || 0;
      const btn = document.getElementById('placeBtn');
      btn.disabled = true;
      setStatus('Отправка...');

      try {
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain' },
          body: JSON.stringify({
            initData: initData,
            amount: amount,
            user: {
              id: user.id,
              username: user.username || '',
              first_name: user.first_name || '',
              last_name: user.last_name || ''
            }
          })
        });

        const data = await res.json();

        if (data.error || data.ok === false) {
          tg.showAlert(data.error || 'Ошибка');
          setStatus('');
        } else {
          render(data);
          setStatus(data.message || 'Готово');
          if (tg.HapticFeedback) tg.HapticFeedback.impactOccurred('medium');
          setTimeout(() => setStatus(''), 2000);
        }
      } catch (e) {
        tg.showAlert('Ошибка сети');
        setStatus('');
        console.error(e);
      }

      btn.disabled = isEnded;
    }

    document.getElementById('plusBtn').onclick = () => {
      const input = document.getElementById('bidInput');
      input.value = (parseInt(input.value) || 0) + step;
    };

    document.getElementById('minusBtn').onclick = () => {
      const input = document.getElementById('bidInput');
      input.value = Math.max(0, (parseInt(input.value) || 0) - step);
    };

    document.getElementById('placeBtn').onclick = placeBid;

    loadBids();
    setInterval(loadBids, 4000);
  </script>
</body>
</html>
